# Copy this file to backend/.env. Every value is optional: with no .env at all
# the backend runs on SQLite, prints emails to the console, and disables AI features.

# OpenAI: required for the AI features (form generation, Smart Assistant, analytics queries)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kuala_Lumpur

# Frontend origin (CORS, and links in password reset emails)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Database: SQLite unless you switch the engine to PostgreSQL
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ai_office_assistant
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Email: printed to the console by default
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
