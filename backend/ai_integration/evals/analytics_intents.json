{
  "about": [
    "Labelled questions for the analytics intent parser (OpenAIService.parse_analytics_intent).",
    "Run them with: python manage.py eval_ai --output docs/ai-evaluation.md",
    "A case lists only the fields whose right value is unambiguous under the parser's prompt and that change what the backend runs. null means the question names no such filter.",
    "entity is listed for count and list questions, where it decides between form templates and submissions. group_by is listed for breakdowns, and as null for submission lists, which a group_by would turn into a breakdown. time_range is left out of trend questions that name no period, since trends always cover six months.",
    "form_type and department are short names the backend matches with icontains; they are scored by which seeded form or department they select.",
    "The flags is_greeting, is_help_request, is_casual_message and is_gibberish are expected false unless a case sets one: the view answers a flagged message with canned text and runs no query.",
    "language is en, zh or ms; keyboard mashes have none."
  ],
  "cases": [
    {"id": "count-en-1", "language": "en", "question": "How many leave requests were approved last month?",
     "expected": {"query_type": "count", "entity": "submissions",
                  "filters": {"status": ["APPROVED"], "form_type": "leave", "department": null, "time_range": "last_month"}}},
    {"id": "count-en-2", "language": "en", "question": "How many forms are currently active?",
     "expected": {"query_type": "count", "entity": "forms", "filters": {"department": null}}},
    {"id": "count-en-3", "language": "en", "question": "How many requests are still waiting for approval?",
     "expected": {"query_type": "count", "entity": "submissions",
                  "filters": {"status": ["SUBMITTED", "IN_REVIEW"], "form_type": null, "department": null, "time_range": null}}},
    {"id": "count-zh-1", "language": "zh", "question": "上个月有多少报销申请？",
     "expected": {"query_type": "count", "entity": "submissions",
                  "filters": {"status": null, "form_type": "expense", "department": null, "time_range": "last_month"}}},
    {"id": "count-zh-2", "language": "zh", "question": "今天有多少申请被拒绝了？",
     "expected": {"query_type": "count", "entity": "submissions",
                  "filters": {"status": ["REJECTED"], "form_type": null, "department": null, "time_range": "today"}}},
    {"id": "count-ms-1", "language": "ms", "question": "Berapa banyak permohonan cuti minggu lepas?",
     "expected": {"query_type": "count", "entity": "submissions",
                  "filters": {"status": null, "form_type": "leave", "department": null, "time_range": "last_week"}}},
    {"id": "count-ms-2", "language": "ms", "question": "Berapa banyak borang aktif dalam Jabatan HR?",
     "expected": {"query_type": "count", "entity": "forms", "filters": {"department": "HR"}}},

    {"id": "list-en-1", "language": "en", "question": "Who submitted expense claims this week?",
     "expected": {"query_type": "list", "entity": "submissions", "group_by": null,
                  "filters": {"status": null, "form_type": "expense", "department": null, "time_range": "this_week"}}},
    {"id": "list-en-2", "language": "en", "question": "What forms does the Finance department have?",
     "expected": {"query_type": "list", "entity": "forms", "filters": {"department": "Finance"}}},
    {"id": "list-en-3", "language": "en", "question": "Who requested IT equipment this month?",
     "expected": {"query_type": "list", "entity": "submissions", "group_by": null,
                  "filters": {"status": null, "form_type": "IT Equipment", "time_range": "this_month"}}},
    {"id": "list-zh-1", "language": "zh", "question": "上周谁提交了请假申请？",
     "expected": {"query_type": "list", "entity": "submissions", "group_by": null,
                  "filters": {"status": null, "form_type": "leave", "department": null, "time_range": "last_week"}}},
    {"id": "list-zh-2", "language": "zh", "question": "列出所有待审批的申请",
     "expected": {"query_type": "list", "entity": "submissions", "group_by": null,
                  "filters": {"status": ["SUBMITTED", "IN_REVIEW"], "form_type": null, "department": null, "time_range": null}}},
    {"id": "list-ms-1", "language": "ms", "question": "Senaraikan borang dalam Jabatan IT",
     "expected": {"query_type": "list", "entity": "forms", "filters": {"department": "IT"}}},
    {"id": "list-ms-2", "language": "ms", "question": "Siapa yang memohon kerja dari rumah bulan ini?",
     "expected": {"query_type": "list", "entity": "submissions", "group_by": null,
                  "filters": {"status": null, "form_type": "WFH", "department": null, "time_range": "this_month"}}},

    {"id": "trend-en-1", "language": "en", "question": "How have leave requests changed over time?",
     "expected": {"query_type": "trend", "filters": {"status": null, "form_type": "leave", "department": null}}},
    {"id": "trend-en-2", "language": "en", "question": "Show me the monthly submission trend",
     "expected": {"query_type": "trend", "filters": {"status": null, "form_type": null, "department": null}}},
    {"id": "trend-zh-1", "language": "zh", "question": "IT部门今年的申请趋势如何？",
     "expected": {"query_type": "trend",
                  "filters": {"status": null, "form_type": null, "department": "IT", "time_range": "this_year"}}},
    {"id": "trend-ms-1", "language": "ms", "question": "Tunjukkan trend tuntutan perbelanjaan bulanan",
     "expected": {"query_type": "trend", "filters": {"status": null, "form_type": "expense", "department": null}}},

    {"id": "comparison-en-1", "language": "en", "question": "Compare the number of submissions across departments",
     "expected": {"query_type": "comparison",
                  "filters": {"status": null, "form_type": null, "department": null, "time_range": null}}},
    {"id": "comparison-en-2", "language": "en", "question": "IT vs Finance: which department submits more requests?",
     "expected": {"query_type": "comparison", "filters": {"status": null, "form_type": null, "time_range": null}}},
    {"id": "comparison-en-3", "language": "en", "question": "Compare approved requests by department for this year",
     "expected": {"query_type": "comparison",
                  "filters": {"status": ["APPROVED"], "form_type": null, "department": null, "time_range": "this_year"}}},
    {"id": "comparison-zh-1", "language": "zh", "question": "比较各部门上个月的提交数量",
     "expected": {"query_type": "comparison",
                  "filters": {"status": null, "form_type": null, "department": null, "time_range": "last_month"}}},
    {"id": "comparison-ms-1", "language": "ms", "question": "Bandingkan Jabatan HR dengan Jabatan Kewangan",
     "expected": {"query_type": "comparison", "filters": {"status": null, "form_type": null, "time_range": null}}},

    {"id": "breakdown-en-1", "language": "en", "question": "Break down this month's submissions by department",
     "expected": {"query_type": "breakdown", "group_by": "department",
                  "filters": {"status": null, "form_type": null, "department": null, "time_range": "this_month"}}},
    {"id": "breakdown-en-2", "language": "en", "question": "What's the status distribution of expense claims?",
     "expected": {"query_type": "breakdown", "group_by": "status",
                  "filters": {"status": null, "form_type": "expense", "department": null, "time_range": null}}},
    {"id": "breakdown-zh-1", "language": "zh", "question": "按状态统计所有提交",
     "expected": {"query_type": "breakdown", "group_by": "status",
                  "filters": {"status": null, "form_type": null, "department": null, "time_range": null}}},
    {"id": "breakdown-zh-2", "language": "zh", "question": "各部门的请假申请分布",
     "expected": {"query_type": "breakdown", "group_by": "department",
                  "filters": {"status": null, "form_type": "leave", "department": null, "time_range": null}}},
    {"id": "breakdown-ms-1", "language": "ms", "question": "Pecahan penyerahan mengikut status untuk bulan lepas",
     "expected": {"query_type": "breakdown", "group_by": "status",
                  "filters": {"status": null, "form_type": null, "department": null, "time_range": "last_month"}}},
    {"id": "breakdown-ms-2", "language": "ms", "question": "Borang mana yang paling banyak dihantar?",
     "expected": {"query_type": "breakdown", "group_by": "form",
                  "filters": {"status": null, "form_type": null, "department": null, "time_range": null}}},

    {"id": "average-en-1", "language": "en", "question": "What's the average approval time?",
     "expected": {"query_type": "average", "filters": {"form_type": null, "department": null, "time_range": null}}},
    {"id": "average-en-2", "language": "en", "question": "What was the average approval time for the IT department last month?",
     "expected": {"query_type": "average", "filters": {"form_type": null, "department": "IT", "time_range": "last_month"}}},
    {"id": "average-zh-1", "language": "zh", "question": "请假申请平均需要多长时间审批？",
     "expected": {"query_type": "average", "filters": {"form_type": "leave", "department": null, "time_range": null}}},
    {"id": "average-ms-1", "language": "ms", "question": "Berapa purata masa kelulusan untuk permohonan latihan?",
     "expected": {"query_type": "average", "filters": {"form_type": "training", "department": null, "time_range": null}}},

    {"id": "greeting-en-1", "language": "en", "question": "Hello there", "expected": {"is_greeting": true}},
    {"id": "greeting-en-2", "language": "en", "question": "Good morning!", "expected": {"is_greeting": true}},
    {"id": "greeting-zh-1", "language": "zh", "question": "你好", "expected": {"is_greeting": true}},
    {"id": "greeting-ms-1", "language": "ms", "question": "Selamat pagi", "expected": {"is_greeting": true}},

    {"id": "help-en-1", "language": "en", "question": "What can you do?", "expected": {"is_help_request": true}},
    {"id": "help-en-2", "language": "en", "question": "How do I use this assistant?", "expected": {"is_help_request": true}},
    {"id": "help-zh-1", "language": "zh", "question": "你能帮我做什么？", "expected": {"is_help_request": true}},
    {"id": "help-ms-1", "language": "ms", "question": "Apa yang boleh awak buat?", "expected": {"is_help_request": true}},

    {"id": "gibberish-none-1", "language": "none", "question": "sdfkjh wqpoe", "expected": {"is_gibberish": true}},
    {"id": "gibberish-none-2", "language": "none", "question": "zzzz xxxx ;;;;", "expected": {"is_gibberish": true}},
    {"id": "gibberish-zh-1", "language": "zh", "question": "香蕉 飞 蓝色 桌子 跑", "expected": {"is_gibberish": true}},
    {"id": "gibberish-ms-1", "language": "ms", "question": "kucing biru terbang meja nasi", "expected": {"is_gibberish": true}}
  ]
}
